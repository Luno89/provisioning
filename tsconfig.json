{
  // NOT the project's typecheck entry point: `npm run typecheck` runs each workspace's own config.
  // `files` is empty and `references` lists every real config so an editor's language server
  // finds the config that owns a file (scripts/ through tests/tsconfig.json) instead of this one.
  // The compilerOptions stay because tsx reads them when a script runs from the repository root.
  "files": [],
  "references": [
    { "path": "./apps/backend" },
    { "path": "./apps/frontend" },
    { "path": "./apps/local-agent" },
    { "path": "./packages/agent-engine" },
    { "path": "./packages/cdktf-infra" },
    { "path": "./packages/context-engine" },
    { "path": "./packages/engine-core" },
    { "path": "./tests" }
  ],
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "exclude": ["**/.gen/**"]
}
