#!/usr/bin/env bash
set -euo pipefail

TOP="$(git rev-parse --show-toplevel)"
TSX="${TOP}/node_modules/.bin/tsx"
NONE=0000000000000000000000000000000000000000
ORIGIN_URL="$(git remote get-url origin 2>/dev/null || true)"

if [ "${1:-}" != origin ] && { [ -z "$ORIGIN_URL" ] || [ "${2:-}" != "$ORIGIN_URL" ]; }; then
  exit 0
fi

other_branch=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$NONE" ] && continue
  "$TSX" "${TOP}/tests/gate-check.ts" "$remote_ref" "$local_sha" < /dev/null
  case "$remote_ref" in
    refs/heads/main | refs/tags/v*) ;;
    refs/heads/*) other_branch=1 ;;
  esac
done

if [ "$other_branch" = 1 ]; then
  echo "pre-push: typecheck…"
  if ! npm run typecheck --silent; then
    echo ""
    echo "  ✗ typecheck failed — push aborted."
    echo "    Fix it, or use 'git push --no-verify' if you genuinely mean to push this."
    exit 1
  fi
  echo "  ✓ typecheck clean"
fi
