#!/usr/bin/env bash
set -euo pipefail

pushing_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && pushing_main=1
done

gate() {
  local name="$1"; shift
  echo "pre-push: ${name}…"
  if ! "$@"; then
    echo ""
    echo "  ✗ ${name} failed — push aborted."
    echo "    Fix it, or use 'git push --no-verify' if you genuinely mean to push this."
    exit 1
  fi
  echo "  ✓ ${name} clean"
}

if [ "$pushing_main" = 0 ]; then
  gate typecheck npm run typecheck --silent
  exit 0
fi

echo "pre-push: main takes the whole first gate (typecheck, lint, unit)"
gate "typecheck + unit" npm run test:unit --silent
gate lint npm run lint --silent

if curl -s -o /dev/null -w '%{http_code}' http://localhost:3001/api/auth/me | grep -q '^401$' && [ -n "${MECHANICS_ADMIN:-}" ]; then
  gate "routes-live against the running dev stack" npm run test:routes-live --silent
else
  echo "pre-push: no dev stack answering on :3001 with MECHANICS_ADMIN set, so routes-live is skipped; CI's second gate runs it"
fi
