{
  "name": "@koala/context-engine",
  "version": "1.0.0",
  "type": "module",
  "description": "Autonomous intelligent context engine: observation masking, token estimation, dual-boundary clipping, and scope-preserving progressive compaction",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --maxWorkers=50% --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@koala/harness-types": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9"
  }
}
