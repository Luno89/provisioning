{
  "name": "@koala/engine-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The parts of the agent engine that run wherever the work runs — environment capabilities, path confinement, tool contracts, tool execution and Koala's own telemetry. Shared by the backend and by the worker on a user's own machine.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    },
    "./payloads": {
      "types": "./src/payload-codec.ts",
      "default": "./src/payload-codec.ts"
    },
    "./telemetry": {
      "types": "./src/telemetry.ts",
      "default": "./src/telemetry.ts"
    }
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/otlp-transformer": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@temporalio/common": "^1.23.0"
  },
  "scripts": {
    "test": "vitest run"
  }
}
