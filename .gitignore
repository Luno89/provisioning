# Node / Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# CDKTF / Terraform
.terraform/
.terraform-cache/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
*.tfvars
*.tfvars.json
cdktf.out/
.gen/

# Backend runtime data
/apps/backend/data/*.json
!/apps/backend/data/*.json.example
/apps/backend/data/logs/
/apps/backend/data/nginx/conf.d/*
!/apps/backend/data/nginx/conf.d/default.conf
/apps/backend/data/.gitea-admin-password
/apps/backend/data/.gitea-admin-token
/apps/backend/data/.headscale-api-key

# k3d node-local storage (bind-mounted host cache for local-path-provisioner PVCs)
/.k3d-storage/

# Shared model weight caches (bind-mounted into k3d nodes — see InfrastructureService.ts)
/.vllm-model-cache/
/.tabbyapi-model-cache/

# Staging area for scripts/backup-to-drive.sh — deleted on every run, never meant to persist
/.backup-tmp/

# Cached base cloud image for tests/remote-host-integration.ts's disposable QEMU VM (~600MB,
# re-downloaded on demand if missing — see tests/lib/disposable-vm.ts)
/tests/.vm-cache/

# rclone remotes/passwords (contains the crypt password if not using the OS keyring)
/rclone.conf
# Generated by apps/backend/src/scripts/generate-rclone-config.ts — contains a live Google Drive
# refresh token in plaintext, regenerated fresh on every backup run.
/.rclone-runtime.conf

# Local config & secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS Metadata
.DS_Store
Thumbs.db
apps/frontend/dist/
