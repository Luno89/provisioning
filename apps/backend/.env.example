# IANTHE Backend Configuration

# General Server Port
PORT=3001

# Platform keys, one per purpose (generated during setup). Production refuses to start without all five.
SESSION_KEY=generate
DATA_KEY=generate
PAYLOAD_KEY=generate
EGRESS_KEY=generate
TEMPORAL_KEY=generate

# Terraform Cloud Settings (Required for CDKTF stacks)
TFC_TOKEN=your_terraform_cloud_token_here
TFC_ORG=your_org_name

# Twilio SMS delivery (Optional: if blank, 2FA SMS codes fall back to warning alerts in developer logs)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# GitHub Social Sign-In (Optional: if blank, triggers a zero-setup local dev mock loop)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Social Sign-In (Optional: if blank, triggers a zero-setup local dev mock loop)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==================================================================
# CLOUD PROVIDER CREDENTIALS
# (If left blank, the platform automatically runs that provider
# in 'Mock Cloud Mode' using local k3d containers for zero-setup dev)
# ==================================================================

# --- AWS (Amazon Web Services) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# --- GCP (Google Cloud Platform) ---
# GCP_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp-service-account-key.json

# --- Azure (Microsoft Azure) ---
# ARM_CLIENT_ID=
# ARM_CLIENT_SECRET=
# ARM_SUBSCRIPTION_ID=
# ARM_TENANT_ID=

# --- DigitalOcean ---
# DIGITALOCEAN_TOKEN=

# --- OVHcloud VPS catalog (Compare plans in Provision a cluster) ---
# The subsidiary whose price list the catalog reads, in its own currency before tax, from the API that serves it:
# ASIA AU CA IN QC SG WE WS on ca.api.ovh.com, CZ DE ES EU FI FR GB IE IT LT MA NL PL PT SN TN on eu.api.ovh.com, US on api.us.ovhcloud.com.
# An Australian account: OVH_SUBSIDIARY=AU (AUD ex GST, Sydney among the datacenters). Default FR.
# OVH_SUBSIDIARY=FR
