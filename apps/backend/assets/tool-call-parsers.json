{
  "vllm": "v0.32.0",
  "parsers": [
    { "parser": "hermes", "label": "Hermes, Qwen 2.5, QwQ, Qwen 3", "template": [{ "contains": "<tool_call>" }, { "matches": "\\{\\\\?\"name\\\\?\": <function-name>, \\\\?\"arguments\\\\?\": <args-" }] },
    { "parser": "qwen3_json", "label": "Qwen 3, as hermes" },
    { "parser": "granite4", "label": "Granite 4.0", "template": [{ "contains": "<tool_call>" }, { "matches": "\\{\\\\?\"name\\\\?\": <function-name>, \\\\?\"arguments\\\\?\": <args-" }], "names": ["(^|/)granite-4\\.0-"] },
    { "parser": "qwen3_coder", "label": "Qwen 3.5, 3.6", "template": [{ "matches": "<tool_call>(\\\\n|\\n)<function=" }] },
    { "parser": "qwen3_xml", "label": "Qwen3-Coder", "template": [{ "matches": "<tool_call>(\\\\n|\\n)<function=" }], "names": ["(^|/)qwen3-coder-"] },
    { "parser": "step3p5", "label": "Step 3.5", "template": [{ "matches": "<tool_call>(\\\\n|\\n)<function=" }], "names": ["(^|/)step-3\\.[57]-flash"] },
    { "parser": "mimo", "label": "MiMo", "template": [{ "matches": "<tool_call>(\\\\n|\\n)<function=" }], "names": ["(^|/)mimo-v2"] },
    { "parser": "seed_oss", "label": "Seed-OSS", "template": [{ "contains": "<seed:tool_call>" }] },
    { "parser": "llama3_json", "label": "Llama 3.1, 3.2, 3.3", "template": [{ "matches": "\\{\\\\?\"name\\\\?\": function name, \\\\?\"parameters\\\\?\": dictionary of argument name and its value\\}" }] },
    { "parser": "llama4_json", "label": "Llama 4, as JSON" },
    { "parser": "llama4_pythonic", "label": "Llama 4", "template": [{ "contains": "[func_name1(param1=value1, param2=value2), func_name2(...)]" }] },
    { "parser": "pythonic", "label": "Pythonic (Llama 3.2 small, ToolACE)" },
    { "parser": "mistral", "label": "Mistral", "template": [{ "contains": "[TOOL_CALLS]" }], "names": ["^mistralai/", "(^|/)(mistral|mixtral)-"] },
    { "parser": "granite", "label": "Granite 3", "template": [{ "contains": "<|tool_call|>" }] },
    { "parser": "granite-20b-fc", "label": "Granite 20B Function Calling" },
    { "parser": "internlm", "label": "InternLM 2.5" },
    { "parser": "jamba", "label": "Jamba 1.5" },
    { "parser": "xlam", "label": "xLAM", "template": [{ "matches": "\\[\\{\\\\?\"name\\\\?\": \\\\?\"tool_call_name\\\\?\", \\\\?\"arguments\\\\?\": " }] },
    { "parser": "deepseek_v3", "label": "DeepSeek V3, R1", "template": [{ "matches": "<｜tool▁call▁begin｜>'\\s*\\+\\s*tool\\['type'\\]" }] },
    { "parser": "deepseek_v31", "label": "DeepSeek V3.1", "template": [{ "matches": "<｜tool▁call▁begin｜>'\\s*\\+\\s*tool\\['function'\\]\\['name'\\]" }] },
    { "parser": "deepseek_v32", "label": "DeepSeek V3.2" },
    { "parser": "deepseek_v4", "label": "DeepSeek V4" },
    { "parser": "deepseek_v41", "label": "DeepSeek V4.1" },
    { "parser": "openai", "label": "gpt-oss", "template": [{ "contains": "<|call|>" }] },
    { "parser": "kimi_k2", "label": "Kimi K2", "template": [{ "contains": "<|tool_calls_section_begin|>" }] },
    { "parser": "kimi_k3", "label": "Kimi K3" },
    { "parser": "k2_horizon", "label": "K2 Horizon" },
    { "parser": "hunyuan_a13b", "label": "Hunyuan A13B", "template": [{ "matches": "<tool_calls>\\[\\{\\\\?\"name\\\\?\": \\\\?\"func_name1\\\\?\"" }] },
    { "parser": "hy_v3", "label": "Hunyuan 3" },
    { "parser": "hy_v4", "label": "Hunyuan 4" },
    { "parser": "cohere_command3", "label": "Command A Reasoning" },
    { "parser": "cohere_command4", "label": "Command A Plus" },
    { "parser": "longcat", "label": "LongCat Flash", "template": [{ "contains": "<longcat_tool_call>" }] },
    { "parser": "glm45", "label": "GLM 4.5, 4.6", "template": [{ "matches": "<tool_call>\\{function-name\\}(\\\\n|\\n)<arg_key>" }] },
    { "parser": "glm47", "label": "GLM 4.7", "template": [{ "contains": "<tool_call>{function-name}<arg_key>" }] },
    { "parser": "functiongemma", "label": "FunctionGemma" },
    { "parser": "gemma4", "label": "Gemma 4", "template": [{ "contains": "<|tool_call>call:" }] },
    { "parser": "olmo3", "label": "Olmo 3", "template": [{ "contains": "<function_calls>" }] },
    { "parser": "gigachat3", "label": "GigaChat 3", "template": [{ "contains": "'role': 'function call'" }] },
    { "parser": "apertus", "label": "Apertus", "template": [{ "contains": "<|tools_prefix|>" }] },
    { "parser": "lfm2", "label": "LFM2", "template": [{ "contains": "<|tool_call_start|>" }] },
    { "parser": "minimax_m2", "label": "MiniMax M2", "template": [{ "contains": "<minimax:tool_call>" }] },
    { "parser": "minimax_m3", "label": "MiniMax M3" },
    { "parser": "ernie45", "label": "ERNIE 4.5", "template": [{ "matches": "<tool_call>(\\\\n|\\n)\\{\\\\?\"name\\\\?\": \\\\?\"'" }], "names": ["(^|/)ernie-4\\.5-"] },
    { "parser": "step3", "label": "Step 3", "template": [{ "contains": "<steptml:invoke name=" }] },
    { "parser": "dots", "label": "dots.llm" },
    { "parser": "ling3", "label": "Ling 3" },
    { "parser": "poolside_v1", "label": "Poolside" },
    { "parser": "minicpm5", "label": "MiniCPM 5" },
    { "parser": "plamo3", "label": "PLaMo 3" },
    { "parser": "muse_glimmer", "label": "Muse Glimmer" },
    { "parser": "phi4_mini_json", "label": "Phi-4-mini" },
    { "parser": "inkling", "label": "Inkling" },
    { "parser": "hf", "label": "The model's own response template" }
  ]
}
