{
  "name": "nowrinkles",
  "version": "1.0.0",
  "description": "No Wrinkles \u2014 spin up Kubernetes clusters on your own hardware or any VPS, and deploy apps to them",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fix-dnd-kit-hoisting.js",
    "setup": "bash scripts/setup.sh",
    "build": "npm run build -w apps/frontend",
    "start": "concurrently --kill-others \"npm run start -w apps/backend\" \"npm run start:worker -w apps/backend\" \"npm run start:worker:cluster -w apps/backend\" \"npm run start:worker:engine -w apps/backend\"",
    "provision:root-node": "tsx scripts/root-node/provision.ts",
    "dev": "bash scripts/dev.sh",
    "dev:split": "bash scripts/dev.sh --split",
    "dev:infisical": "bash scripts/ensure-infisical.sh",
    "clean-dev": "bash scripts/cleanup-all.sh",
    "backup": "bash scripts/backup-to-drive.sh",
    "backup:mongo": "bash scripts/backup-mongo.sh",
    "restore:mongo": "bash scripts/restore-mongo.sh",
    "worker": "bash scripts/first-time.sh --deploy",
    "deploy-worker": "bash scripts/deploy-worker.sh",
    "test": "npm run test:unit && npm run test:e2e:sync",
    "test:all": "npm test && npm run test:synth:palworld && npm run test:infra:integration && npm run test:remote-integration && npm run test:unit:vpn",
    "test:alive": "bash scripts/alive.sh",
    "ship": "tsx tests/ship.ts",
    "release": "tsx tests/release.ts",
    "test:vm-live": "tsx tests/lib/vm-rounds.ts",
    "test:workflows": "bash scripts/workflows-local.sh",
    "deps:update": "tsx scripts/deps-update.ts",
    "test:worker": "tsx tests/worker-isolated.ts",
    "typecheck": "npm run typecheck:context-engine && npm run typecheck:backend && npm run typecheck:frontend && npm run typecheck:infra && npm run typecheck:local-agent && npm run typecheck:agent-engine",
    "typecheck:context-engine": "tsc --noEmit -p packages/context-engine/tsconfig.json",
    "typecheck:backend": "tsc --noEmit -p apps/backend/tsconfig.json",
    "typecheck:frontend": "tsc --noEmit -p apps/frontend/tsconfig.app.json",
    "typecheck:infra": "tsc --noEmit -p packages/cdktf-infra/tsconfig.json",
    "typecheck:local-agent": "tsc --noEmit -p apps/local-agent/tsconfig.json",
    "typecheck:agent-engine": "tsc --noEmit -p packages/agent-engine/tsconfig.json",
    "lint": "npm run lint -w apps/frontend && npm run lint -w apps/backend",
    "test:unit": "npm run typecheck && npm run test:unit:context-engine && npm run test:unit:engine-core && npm run test:unit:agent-engine && npm run test:unit:frontend && npm run test:unit:backend && npm run test:unit:local-agent",
    "test:unit:context-engine": "npm run test -w packages/context-engine",
    "test:unit:agent-engine": "npm run test -w packages/agent-engine",
    "test:unit:engine-core": "npm run test -w packages/engine-core",
    "test:unit:frontend": "npm run test -w apps/frontend",
    "test:unit:backend": "npm run test -w apps/backend",
    "test:unit:local-agent": "npm run test -w apps/local-agent",
    "test:e2e:sync": "npm run test:alive && npm run test:unit && npm run test:test:e2e:setup && npx playwright test tests/e2e.spec.ts && npm run test:test:e2e:teardown",
    "test:e2e": "npm run test:alive && npm run test:test:e2e:setup && npx playwright test e2e && npm run test:test:e2e:teardown",
    "test:infra:integration": "tsx tests/lib/run-live.ts infra-integration",
    "test:remote-integration": "tsx tests/lib/run-live.ts remote-host-integration",
    "test:tree-sandbox": "cd apps/backend && tsx ../../tests/lib/run-live.ts tree-sandbox-integration",
    "test:plan-adoption": "cd apps/backend && tsx ../../tests/lib/run-live.ts plan-adoption-integration",
    "test:planner-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts planner-live",
    "test:leaf-worktrees": "cd apps/backend && tsx ../../tests/lib/run-live.ts leaf-worktrees-integration",
    "test:grove-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts grove-live",
    "test:continue-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts continue-as-new-live",
    "test:big-run-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts big-run-live",
    "test:memory-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts memory-live",
    "test:bench-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts bench-live",
    "test:proposals-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts proposals-live",
    "test:practices-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts practices-live",
    "test:changes-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts changes-live",
    "test:account-removal-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts account-removal-live",
    "test:checks-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts checks-live",
    "test:odoo-release-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts odoo-release-live",
    "test:odoo-customizations-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts odoo-customizations-live",
    "test:restore-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts restore-live",
    "test:odoo-import-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts odoo-import-live",
    "test:tree-to-release-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts tree-to-release-live",
    "test:extensions-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts extensions-live",
    "test:instance-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts instance-live",
    "test:byo-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts byo-machine-live",
    "test:routing-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts routing-live",
    "test:machine-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts machine-live",
    "test:mesh-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts mesh-live",
    "test:secrets-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts secrets-live",
    "test:secret-injection-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts secret-injection-live",
    "test:mcp-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts mcp-live",
    "test:kube-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts kube-live",
    "test:platform-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts platform-live",
    "test:egress-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts egress-live",
    "test:access-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts access-live",
    "test:app-spec-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts app-spec-live",
    "test:service-claim-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts service-claim-live",
    "test:corpus-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts corpus-live",
    "test:level1-live": "cd apps/backend && tsx ../../tests/level1-live.ts",
    "test:unit:vpn": "node packages/cdktf-infra/lib/vpn-service.spec.js",
    "test:synth:palworld": "tsx tests/palworld-synth.ts",
    "test:test:e2e:setup": "bash scripts/test-e2e-setup.sh",
    "test:test:e2e:teardown": "bash scripts/test-e2e-teardown.sh",
    "test:hetzner-integration": "tsx tests/hetzner-integration.ts",
    "test:monitoring-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts monitoring-live",
    "test:telemetry-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts telemetry-live",
    "test:infrastructure-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts infrastructure-live",
    "test:dev-split-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts dev-split-live",
    "test:hub-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts hub-live",
    "test:routes-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts routes-live",
    "test:app-names-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts app-names-live",
    "test:app-sign-in-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts app-sign-in-live",
    "test:machine-container-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts machine-container-live",
    "test:project-sharing-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts project-sharing-live",
    "test:openrouter-connect-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts openrouter-connect-live",
    "test:machine-story-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts machine-story-live",
    "test:machine-odoo-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts machine-odoo-live",
    "test:machine-chat-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts machine-chat-live",
    "test:machine-default-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts machine-default-live",
    "test:files-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts files-live",
    "test:mail-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts mail-live",
    "test:pool-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts pool-live",
    "test:release-live": "cd apps/backend && tsx ../../tests/lib/run-live.ts release-live",
    "dev:steady": "bash scripts/dev.sh --steady"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "concurrently": "^8.2.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "protobufjs": "^8.7.1"
  },
  "overrides": {
    "seroval": "1.6.9"
  }
}
